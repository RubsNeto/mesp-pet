{
  "name": "mesp-pet",
  "version": "0.1.0",
  "description": "MESP Code - pixel art coding companion powered by OpenCode and 9Router",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "MESP",
  "license": "MIT",
  "scripts": {
    "patch-gyp": "node scripts/patch-gyp.js",
    "postinstall": "node scripts/patch-gyp.js && electron-builder install-app-deps",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/summarize.test.mjs tests/kiroBridge.spawn.test.mjs tests/procedural.test.mjs tests/sanitize.test.mjs tests/persistence.test.mjs tests/composer.test.mjs tests/stateDetect.test.mjs tests/costParse.test.mjs tests/runLog.test.mjs tests/contextStore.test.mjs tests/settingsStore.test.mjs tests/commandPalette.test.mjs tests/primer.test.mjs tests/traitsCatalog.test.mjs tests/primaryStore.test.mjs tests/presetsStore.test.mjs tests/mespCodeCore.test.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "rebuild-native": "node scripts/patch-gyp.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "9router": "0.5.40",
    "node": "22.17.1",
    "npm": "11.18.0",
    "opencode-ai": "1.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "io.mesp.pet",
    "productName": "MESP Pet",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/9router/**",
      "!node_modules/opencode-darwin-*/**",
      "!node_modules/opencode-linux-*/**",
      "!node_modules/opencode-windows-*/**"
    ],
    "asarUnpack": [
      "**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/9router",
        "to": "runtime/9router",
        "filter": [
          "app/**/*",
          "LICENSE",
          "package.json"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
