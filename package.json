{
  "name": "mesp-top-dock",
  "version": "0.1.0",
  "description": "MESP companion with Coucou-style top island and per-project coding agents",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "MESP",
  "license": "MIT",
  "scripts": {
    "patch-gyp": "node scripts/patch-gyp.js",
    "postinstall": "install-electron && node scripts/patch-gyp.js && electron-builder install-app-deps",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/summarize.test.mjs tests/kiroBridge.spawn.test.mjs tests/procedural.test.mjs tests/sanitize.test.mjs tests/persistence.test.mjs tests/composer.test.mjs tests/stateDetect.test.mjs tests/costParse.test.mjs tests/runLog.test.mjs tests/contextStore.test.mjs tests/settingsStore.test.mjs tests/commandPalette.test.mjs tests/primer.test.mjs tests/traitsCatalog.test.mjs tests/primaryStore.test.mjs tests/presetsStore.test.mjs tests/mespCodeCore.test.mjs tests/dockCore.test.mjs tests/coucouMotion.test.mjs tests/dockHooks.test.mjs tests/dockTraits.test.mjs tests/dockTitles.test.mjs tests/dockRouter.test.mjs tests/dockChat.test.mjs tests/dockMotion.test.mjs tests/dockAgent.test.mjs tests/dockProcessTree.test.mjs tests/dockOwnedTask.test.mjs tests/dockComputerTools.test.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "rebuild-native": "node scripts/patch-gyp.js && electron-builder install-app-deps",
    "test:dock": "node tests/dockRouting.electron.cjs && node tests/dockAudit.electron.cjs",
    "test:usability": "node tests/dockUsability.electron.cjs",
    "test:history": "node tests/dockHistory.electron.cjs",
    "test:settings": "node tests/dockSettings.electron.cjs",
    "test:router": "node tests/dockRouter.electron.cjs",
    "test:router:auto": "node tests/dockRouter.runtime.cjs",
    "test:audit": "node tests/dockAudit.electron.cjs",
    "test:chat": "node tests/dockRouting.electron.cjs",
    "test:projects": "node tests/dockProjects.electron.cjs",
    "test:agent": "node tests/dockAgent.electron.cjs && node tests/dockAgent.electron.cjs --parallel-only",
    "test:computer": "node tests/dockComputer.electron.cjs && node tests/dockComputer.electron.cjs --dashboard-locked",
    "test:complete": "node scripts/validate-dock.cjs",
    "test:performance": "node tests/dockPerformance.electron.cjs",
    "test:routing": "node tests/dockRouting.electron.cjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "9router": "0.5.40",
    "node": "22.17.1",
    "npm": "11.18.0",
    "opencode-ai": "1.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "io.mesp.topdock",
    "productName": "MESP Top Dock",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/9router/**",
      "!node_modules/opencode-darwin-*/**",
      "!node_modules/opencode-linux-*/**",
      "!node_modules/opencode-windows-*/**"
    ],
    "asarUnpack": [
      "**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "electron/dockComputerTools.cjs",
        "to": "runtime/mesp-computer/dockComputerTools.cjs"
      },
      {
        "from": "electron",
        "to": "runtime/mesp-router",
        "filter": [
          "dockRouterRuntime.cjs",
          "dockRouter.mjs",
          "dockProviderCatalog.mjs",
          "dockRouterLocalAuth.mjs",
          "dockChatResponse.mjs"
        ]
      },
      {
        "from": "node_modules/9router",
        "to": "runtime/9router",
        "filter": [
          "app/**/*",
          "LICENSE",
          "package.json"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
