{
  "name": "mesp-pet",
  "version": "0.1.0",
  "description": "MESP - pixel art desktop pet/companion for Kiro CLI built with Electron + Vite + React + TypeScript",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "MESP",
  "license": "MIT",
  "scripts": {
    "extract-sprites": "node scripts/extract-sprites.js",
    "predev": "npm run extract-sprites",
    "prebuild": "npm run extract-sprites",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/summarize.test.mjs tests/kiroBridge.spawn.test.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "io.mesp.pet",
    "productName": "MESP Pet",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
