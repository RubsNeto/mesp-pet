# Comando usado pelo bridge para invocar a Kiro CLI ou outro processo de terminal.
# Pode ser apenas o nome no PATH (ex.: kiro-cli) ou caminho absoluto.
KIRO_COMMAND=kiro-cli

# Argumentos padrão (separados por espaços) usados quando NENHUM argumento é
# passado pelo renderer. Usado pelo botão "Executar" do MockControls quando o
# campo de args fica vazio.
KIRO_DEFAULT_ARGS=

# Prefixo de args inserido ANTES do prompt digitado no chat panel.
# Exemplo: se KIRO_TASK_PREFIX=chat, ao abrir o terminal o app roda:
#     kiro-cli chat
# Use "chat" para abrir o REPL interativo.
KIRO_TASK_PREFIX=chat
