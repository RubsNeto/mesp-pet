# Comando padrão do painel. 9code abre o chat nativo MESP Code.
# Outros nomes na PATH continuam disponíveis pelos presets de terminal.
KIRO_COMMAND=9code

# Argumentos padrão (separados por espaços) usados quando NENHUM argumento é
# passado pelo renderer. Usado pelo botão "Executar" do MockControls quando o
# campo de args fica vazio.
KIRO_DEFAULT_ARGS=

# Prefixo de args usado apenas pelos presets de terminal.
KIRO_TASK_PREFIX=
