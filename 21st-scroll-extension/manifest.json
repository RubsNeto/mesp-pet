{
  "manifest_version": 3,
  "name": "21st.dev - Forçar Scroll",
  "version": "1.2.0",
  "description": "Restaura o scroll vertical no 21st.dev removendo travas de overflow/altura aplicadas pelo app.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://21st.dev/*", "https://*.21st.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
